# CampusOverflow 环境变量模板
# 用法：复制为 .env 后按环境修改；.env 不入库。
#   cp deploy/.env.example .env

# ---- 数据库（生产环境务必修改默认密码） ----
MYSQL_ROOT_PASSWORD=change_me_root_pwd
DB_PASSWORD=change_me_campus_pwd

# ---- 监控 ----
GRAFANA_PASSWORD=change_me_grafana_admin

# ---- 应用 ----
# 正式使用去掉 demo（演示数据）：SPRING_PROFILES=prod
SPRING_PROFILES=prod,demo
# 启用 HTTPS 后改为 true
COOKIE_SECURE=false
# 本地构建镜像的版本标签
APP_VERSION=latest

# ---- 自动部署（仅在从 GHCR 拉镜像时由 CI 注入，通常无需手动设置） ----
# BACKEND_IMAGE=ghcr.io/<owner>/campus-overflow-backend:<sha>
# WEB_IMAGE=ghcr.io/<owner>/campus-overflow-web:<sha>
