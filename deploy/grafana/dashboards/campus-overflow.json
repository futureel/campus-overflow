{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["campus-overflow"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "CampusOverflow 系统监控",
  "uid": "campus-overflow-overview",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "业务指标（发件箱 / 声誉）",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "发件箱积压（待投递）",
      "datasource": { "type": "prometheus", "uid": "campus-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "co_outbox_backlog", "legendFormat": "backlog" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 100 } ] } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "死信事件（需人工介入）",
      "datasource": { "type": "prometheus", "uid": "campus-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "co_outbox_dead_letters", "legendFormat": "dead letters" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "已成功投递事件总数",
      "datasource": { "type": "prometheus", "uid": "campus-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "co_outbox_published_total", "legendFormat": "published" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "投递失败事件总数",
      "datasource": { "type": "prometheus", "uid": "campus-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "co_outbox_failed_total", "legendFormat": "failed" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 } ] } },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "声誉对账不一致账户（应恒为 0）",
      "datasource": { "type": "prometheus", "uid": "campus-prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 7 },
      "targets": [
        { "refId": "A", "expr": "co_reputation_mismatches", "legendFormat": "mismatches" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "应用性能（HTTP）",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP 请求速率（req/s）",
      "datasource": { "type": "prometheus", "uid": "campus-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "sum by (uri) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{uri}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP 响应时延 P95（ms）",
      "datasource": { "type": "prometheus", "uid": "campus-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{uri}} P95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "row",
      "title": "JVM / 系统",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "JVM 堆内存（bytes）",
      "datasource": { "type": "prometheus", "uid": "campus-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "jvm_memory_used_bytes{area=\"heap\"}", "legendFormat": "{{id}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "进程 CPU 使用率",
      "datasource": { "type": "prometheus", "uid": "campus-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "process_cpu_usage", "legendFormat": "cpu" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "JVM 活跃线程数",
      "datasource": { "type": "prometheus", "uid": "campus-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "jvm_threads_live_threads", "legendFormat": "live threads" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    }
  ]
}
